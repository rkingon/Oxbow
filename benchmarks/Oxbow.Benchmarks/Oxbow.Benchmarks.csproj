<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <RootNamespace>Oxbow.Benchmarks</RootNamespace>
    <!-- Benchmark classes must be public and unsealed for BenchmarkDotNet. -->
    <NoWarn>$(NoWarn);CA1515;CA1001;CA2007;CA1822;CA1852</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\src\Oxbow\Oxbow.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="BenchmarkDotNet" />
    <PackageReference Include="Microsoft.Extensions.Hosting" />
    <PackageReference Include="Npgsql.DependencyInjection" />
    <PackageReference Include="Testcontainers.PostgreSql" />
  </ItemGroup>

</Project>
